@{
    ViewData["Title"] = "Transactions - FitHub";
}

@section Styles {
    <link rel="stylesheet" href="~/css/transaction.css" asp-append-version="true" />
}

<main id="Transactions-page">

    <section id="Transactions-hero">
        <h1>Transactions History</h1>
        <p>View and track all your FitHub payments and billing activity.</p>
    </section>

    <section id="Transactions-summary">

        <div>
            <h3>Total Paid</h3>
            <p>@ViewBag.TotalPaid</p>
            <span>All Time</span>
        </div>

        <div>
            <h3>Last Payment</h3>
            <p>@ViewBag.LastPaymentAmount</p>
            <span>@ViewBag.LastPaymentDate</span>
        </div>

        <div>
            <h3>Next Billing</h3>
            <p>@ViewBag.NextBillingAmount</p>
            <span>@ViewBag.NextBillingDate</span>
        </div>

        <div>
            <h3>Payment Method</h3>
            <p>@ViewBag.PaymentMethod</p>
            <span>On File</span>
        </div>

    </section>

    <section id="Transactions-filters">
        <form asp-controller="Transactions" asp-action="Index" method="get">

            <div>
                <label for="search">Search</label>
                <input type="text" id="search" name="search" value="@ViewBag.Search" placeholder="Search Transactions..." />
            </div>

            <div>
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="">All Statuses</option>
                    <option value="Paid" selected="@(ViewBag.StatusFilter == "Paid")">Paid</option>
                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                    <option value="Failed" selected="@(ViewBag.StatusFilter == "Failed")">Failed</option>
                    <option value="Refunded" selected="@(ViewBag.StatusFilter == "Refunded")">Refunded</option>
                </select>
            </div>

            <div>
                <label for="type">Type</label>
                <select id="type" name="type">
                    <option value="">All Types</option>
                    <option value="Subscription" selected="@(ViewBag.TypeFilter == "Subscription")">Subscription</option>
                    <option value="Upgrade" selected="@(ViewBag.TypeFilter == "Upgrade")">Upgrade</option>
                    <option value="Renewal" selected="@(ViewBag.TypeFilter == "Renewal")">Renewal</option>
                    <option value="Refund" selected="@(ViewBag.TypeFilter == "Refund")">Refund</option>
                </select>
            </div>

            <div>
                <label for="dateFrom">From</label>
                <input type="date" id="dateFrom" name="dateFrom" value="@ViewBag.DateFrom" />
            </div>

            <div>
                <label for="dateTo">To</label>
                <input type="date" id="dateTo" name="dateTo" value="@ViewBag.DateTo" />
            </div>

            <div>
                <button type="submit">Filter</button>
                <a asp-controller="Transactions" asp-action="Index">Reset</a>
            </div>

        </form>
    </section>

    <section id="Transactions-table-section">

        @if (Model != null && Model.Count > 0)
        {
            <table id="Transactions-table">
                <thead>
                    <tr>
                        <th>Transactions ID</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var Transactions in Model)
                    {
                        <tr>
                            <td>@Transactions.TransactionId</td>
                            <td>@Transactions.Date.ToString("MMM dd, yyyy")</td>
                            <td>@Transactions.Description</td>
                            <td>@Transactions.Type</td>
                            <td>@Transactions.Amount.ToString("C")</td>
                            <td>@Transactions.PaymentMethod</td>
                            <td>
                                <span>@Transactions.Status</span>
                            </td>
                            <td>
                                <a asp-controller="Transactions" asp-action="Details" asp-route-id="@Transactions.TransactionId">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="Transactions-pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Transactions" asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.StatusFilter"
                           asp-route-type="@ViewBag.TypeFilter">
                        Previous
                    </a>
                }

                <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-controller="Transactions" asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.StatusFilter"
                           asp-route-type="@ViewBag.TypeFilter">
                        Next
                    </a>
                }
            </div>
        }
        else
        {
            <div id="no-Transactions">
                <p>No Transactions found.</p>
                <a asp-controller="Membership" asp-action="Index">Browse Membership Plans</a>
            </div>
        }

    </section>

</main>