@{
    ViewData["Title"] = "My Profile - FitHub";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<main id="profile-page">

    <section id="profile-hero">
        <h1>My Profile</h1>
        <p>Manage your personal information, membership, and account settings.</p>
    </section>

    <section id="profile-layout">

        <aside id="profile-sidebar">

            <div id="profile-avatar-section">
                <img src="@(ViewBag.ProfilePhoto ?? "/images/default-avatar.png")" alt="Profile photo of @ViewBag.FullName" />
                <h2>@ViewBag.FullName</h2>
                <p>@ViewBag.MembershipPlan Member</p>
                <p>Member since @ViewBag.MemberSince</p>
            </div>

            <div id="profile-sidebar-links">
                <ul>
                    <li><a href="#personal-info">Personal Information</a></li>
                    <li><a href="#membership-info">Membership Info</a></li>
                    <li><a href="#change-password">Change Password</a></li>
                    <li><a href="#danger-zone">Danger Zone</a></li>
                </ul>
            </div>

        </aside>

        <div id="profile-content">

            @if (TempData["SuccessMessage"] != null)
            {
                <div id="success-message">
                    <p>@TempData["SuccessMessage"]</p>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div id="error-message">
                    <p>@TempData["ErrorMessage"]</p>
                </div>
            }

            <div id="personal-info">
                <h2>Personal Information</h2>
                <p>Update your personal details below.</p>

                <form asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">

                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All"></div>

                    <div>
                        <label>Full Name</label>
                        <input type="text" name="fullName" value="@ViewBag.FullName" placeholder="e.g. Juan dela Cruz" required />
                        <span></span>
                    </div>

                    <div>
                        <label>Email Address</label>
                        <input type="email" value="@ViewBag.Email" placeholder="you@email.com" disabled />
                        <span></span>
                    </div>

                    <div>
                        <label>Phone Number</label>
                        <input type="tel" name="phoneNumber" value="@ViewBag.PhoneNumber" placeholder="+63 912 345 6789" />
                        <span></span>
                    </div>

                    <div>
                        <label>Date of Birth</label>
                        <input type="date" name="dateOfBirth" value="@ViewBag.DateOfBirth" />
                        <span></span>
                    </div>

                    <div>
                        <label>Gender</label>
                        <select name="gender">
                            <option value="">-- Select Gender --</option>
                            <option value="Male" selected="@(ViewBag.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(ViewBag.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(ViewBag.Gender == "Other")">Other</option>
                            <option value="PreferNotToSay" selected="@(ViewBag.Gender == "PreferNotToSay")">Prefer not to say</option>
                        </select>
                        <span></span>
                    </div>

                    <div>
                        <label>Address</label>
                        <input type="text" name="address" value="@ViewBag.Address" placeholder="Street, City, Province" />
                        <span></span>
                    </div>

                    <div>
                        <label for="ProfilePhoto">Profile Photo</label>
                        <input type="file" id="ProfilePhoto" name="ProfilePhoto" accept="image/*" />
                        <small>Accepted formats: JPG, PNG. Max size: 2MB.</small>
                    </div>

                    <div>
                        <button type="submit">Save Changes</button>
                    </div>

                </form>
            </div>

            <hr />

            <div id="membership-info">
                <h2>Membership Information</h2>
                <p>Your current plan and billing details.</p>

                <table>
                    <tbody>
                        <tr>
                            <td>Current Plan</td>
                            <td>@ViewBag.MembershipPlan</td>
                        </tr>
                        <tr>
                            <td>Status</td>
                            <td>@ViewBag.MembershipStatus</td>
                        </tr>
                        <tr>
                            <td>Member Since</td>
                            <td>@ViewBag.MemberSince</td>
                        </tr>
                        <tr>
                            <td>Next Billing Date</td>
                            <td>@ViewBag.NextBillingDate</td>
                        </tr>
                        <tr>
                            <td>Monthly Fee</td>
                            <td>@ViewBag.MonthlyFee</td>
                        </tr>
                        <tr>
                            <td>Payment Method</td>
                            <td>@ViewBag.PaymentMethod</td>
                        </tr>
                    </tbody>
                </table>

                <div>
                    <a asp-controller="Membership" asp-action="Index">Upgrade Plan</a>
                    <a asp-controller="Membership" asp-action="Cancel">Cancel Membership</a>
                </div>
            </div>

            <hr />

            <div id="change-password">
                <h2>Change Password</h2>
                <p>Make sure your new password is at least 8 characters long.</p>

                <form asp-controller="Account" asp-action="ChangePassword" method="post">

                    @Html.AntiForgeryToken()

                    <div>
                        <label>Current Password</label>
                        <input type="password" name="currentPassword" placeholder="Enter current password" required />
                        <span></span>
                    </div>

                    <div>
                        <label>New Password</label>
                        <input type="password" name="newPassword" placeholder="Enter new password" required />
                        <span></span>
                    </div>

                    <div>
                        <label>Confirm New Password</label>
                        <input type="password" name="confirmPassword" placeholder="Re-enter new password" required />
                        <span></span>
                    </div>

                    <div>
                        <button type="submit">Update Password</button>
                    </div>

                </form>
            </div>

            <hr />

            <div id="danger-zone">
                <h2>Danger Zone</h2>
                <p>Permanent actions that cannot be undone. Proceed with caution.</p>

                <div>
                    <div>
                        <div>
                            <h3>Deactivate Account</h3>
                            <p>Temporarily disable your account. You can reactivate it by logging back in.</p>
                        </div>
                        <form asp-controller="Account" asp-action="DeactivateAccount" method="post" id="deactivate-form">
                            @Html.AntiForgeryToken()
                            <button type="submit">Deactivate Account</button>
                        </form>
                    </div>

                    <div>
                        <div>
                            <h3>Delete Account</h3>
                            <p>Permanently delete your account and all associated data. This action cannot be undone.</p>
                        </div>
                        <form asp-controller="Account" asp-action="DeleteAccount" method="post" id="delete-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="confirm" value="true" />
                            <button type="submit">Delete My Account</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script src="~/js/profile-edit.js" asp-append-version="true"></script>
    <script>
        (function () {
            const form = document.querySelector('#change-password form');
            if (!form) return;

            form.addEventListener('submit', function (e) {
                const current = form.querySelector('[name="currentPassword"]').value;
                const next = form.querySelector('[name="newPassword"]').value;
                const confirm = form.querySelector('[name="confirmPassword"]').value;
                let valid = true;

                if (!current) {
                    window.showToast('Current password is required.', 'error');
                    valid = false;
                }
                if (!next || next.length < 8) {
                    window.showToast('New password must be at least 8 characters.', 'error');
                    valid = false;
                } else if (!/[A-Za-z]/.test(next) || !/\d/.test(next)) {
                    window.showToast('New password must include both letters and numbers.', 'error');
                    valid = false;
                }
                if (next === current && current) {
                    window.showToast('New password must be different from current password.', 'error');
                    valid = false;
                }
                if (next !== confirm) {
                    window.showToast('Passwords do not match.', 'error');
                    valid = false;
                }

                if (!valid) e.preventDefault();
            });
        })();

        (function () {
            const deactivate = document.getElementById('deactivate-form');
            if (deactivate) {
                deactivate.addEventListener('submit', function (e) {
                    if (!confirm('Are you sure you want to deactivate your account? You will be signed out and can reactivate by logging back in.')) {
                        e.preventDefault();
                    }
                });
            }

            const del = document.getElementById('delete-form');
            if (del) {
                del.addEventListener('submit', function (e) {
                    const first = confirm('Permanently delete your account? This cannot be undone.');
                    if (!first) { e.preventDefault(); return; }
                    const second = confirm('Last chance — really delete? All your data will be removed.');
                    if (!second) e.preventDefault();
                });
            }
        })();
    </script>
}
