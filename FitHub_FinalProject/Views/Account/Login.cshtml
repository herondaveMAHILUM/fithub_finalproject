@{
    ViewData["Title"] = "Log In - FitHub";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<main id="login-page">

    <section id="login-hero">
        <h1>Welcome Back</h1>
        <p>Log in to your FitHub account to continue your journey.</p>
    </section>

    <section id="login-form-section">
        <div id="login-container">

            <h2>Log In</h2>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"></div>

                <div>
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@email.com" />
                    <span></span>
                </div>

                <div>
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Enter your password" />
                    <span></span>
                </div>

                <div>
                    <input type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                    <label for="rememberMe">Remember Me</label>
                </div>

                <div>
                    <a asp-controller="Account" asp-action="ForgotPassword">Forgot your password?</a>
                </div>

                <div>
                    <button type="submit">Log In</button>
                </div>

            </form>

            <div>
                <p>Don't have an account yet? <a asp-controller="Account" asp-action="Register">Register here</a></p>
            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('#login-container form');
            if (!form) return;

            const emailInput    = form.querySelector('input[name="email"]');
            const passwordInput = form.querySelector('input[name="password"]');
            const emailRegex    = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            // Real-time: clear error state on typing
            emailInput.addEventListener('input', function () {
                this.style.borderColor = '';
            });
            passwordInput.addEventListener('input', function () {
                this.style.borderColor = '';
            });

            function highlight(input) {
                input.style.borderColor = '#dc2626';
                input.focus();
            }

            form.addEventListener('submit', function (e) {
                const email    = emailInput.value.trim();
                const password = passwordInput.value;

                // Check email first
                if (!email) {
                    window.showToast('Email address is required.', 'error');
                    highlight(emailInput);
                    e.preventDefault();
                    return;
                }
                if (!emailRegex.test(email)) {
                    window.showToast('Please enter a valid email address (e.g. you@@email.com).', 'error');
                    highlight(emailInput);
                    e.preventDefault();
                    return;
                }

                // Then password
                if (!password) {
                    window.showToast('Password is required.', 'error');
                    highlight(passwordInput);
                    e.preventDefault();
                    return;
                }
            });
        })();
    </script>
}
