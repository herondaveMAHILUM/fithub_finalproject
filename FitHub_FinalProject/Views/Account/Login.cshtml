@{
    ViewData["Title"] = "Log In - FitHub";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<main id="login-page">

    <section id="login-hero">
        <h1>Welcome Back</h1>
        <p>Log in to your FitHub account to continue your journey.</p>
    </section>

    <section id="login-form-section">
        <div id="login-container">

            <h2>Log In</h2>

            <form asp-controller="Account" asp-action="Login" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"></div>

                <div>
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@email.com" required />
                    <span></span>
                </div>

                <div>
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Enter your password" required />
                    <span></span>
                </div>

                <div>
                    <input type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                    <label for="rememberMe">Remember Me</label>
                </div>

                <div>
                    <a asp-controller="Account" asp-action="ForgotPassword">Forgot your password?</a>
                </div>

                <div>
                    <button type="submit">Log In</button>
                </div>

            </form>

            <div>
                <p>Don't have an account yet? <a asp-controller="Account" asp-action="Register">Register here</a></p>
            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('#login-container form');
            if (!form) return;

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            form.addEventListener('submit', function (e) {
                const email = form.querySelector('input[name="email"]').value.trim();
                const password = form.querySelector('input[name="password"]').value;
                let valid = true;

                if (!email) {
                    window.showToast('Email is required.', 'error');
                    valid = false;
                } else if (!emailRegex.test(email)) {
                    window.showToast('Please enter a valid email address.', 'error');
                    valid = false;
                }

                if (!password) {
                    window.showToast('Password is required.', 'error');
                    valid = false;
                }

                if (!valid) e.preventDefault();
            });
        })();
    </script>
}
