@{
    ViewData["Title"] = "Register - FitHub";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<main id="register-page">

    <section id="register-hero">
        <h1>Create Your Account</h1>
        <p>Join FitHub today and start your fitness journey.</p>
    </section>

    <section id="register-form-section">
        <div id="register-container">

            <h2>Sign Up</h2>

            <form asp-controller="Account" asp-action="Register" method="post" novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"></div>

                <div>
                    <label>First Name</label>
                    <input type="text" name="firstName" placeholder="e.g. Juan" />
                    <span></span>
                </div>

                <div>
                    <label>Last Name</label>
                    <input type="text" name="lastName" placeholder="e.g. dela Cruz" />
                    <span></span>
                </div>

                <div class="full-width">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@email.com" />
                    <span></span>
                </div>

                <div>
                    <label>Phone Number</label>
                    <input type="tel" name="phoneNumber" placeholder="+63 912 345 6789" />
                    <span></span>
                </div>

                <div>
                    <label>Date of Birth</label>
                    <input type="date" name="dateOfBirth" />
                    <span></span>
                </div>

                <div>
                    <label>Gender</label>
                    <select name="gender">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                        <option value="PreferNotToSay">Prefer not to say</option>
                    </select>
                    <span></span>
                </div>

                <div class="full-width">
                    <label>Address</label>
                    <input type="text" name="address" placeholder="Street, City, Province" />
                    <span></span>
                </div>

                <div>
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Min. 8 characters" />
                    <span></span>
                </div>

                <div>
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" placeholder="Re-enter your password" />
                    <span></span>
                </div>

                <div>
                    <input type="checkbox" id="agreeTerms" name="agreeTerms" />
                    <label for="agreeTerms">
                        I agree to the <a asp-controller="Home" asp-action="Terms">Terms and Conditions</a>
                        and <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.
                    </label>
                </div>

                <div>
                    <button type="submit">Create Account</button>
                </div>

            </form>

            <div>
                <p>Already have an account? <a asp-controller="Account" asp-action="Login">Log In here</a></p>
            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('#register-container form');
            if (!form) return;

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            const phoneRegex = /^[\d\s+\-()]{7,20}$/;

            function field(name) {
                return form.querySelector('[name="' + name + '"]');
            }
            function val(name) {
                const el = field(name);
                return el ? el.value.trim() : '';
            }
            function highlight(name) {
                const el = field(name);
                if (el) {
                    el.style.borderColor = '#dc2626';
                    el.focus();
                    el.addEventListener('input', function clear() {
                        el.style.borderColor = '';
                        el.removeEventListener('input', clear);
                    }, { once: true });
                }
            }
            function ageFromDob(dobStr) {
                if (!dobStr) return null;
                const dob = new Date(dobStr);
                if (isNaN(dob.getTime())) return null;
                const now = new Date();
                let age = now.getFullYear() - dob.getFullYear();
                const m = now.getMonth() - dob.getMonth();
                if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
                return age;
            }

            form.addEventListener('submit', function (e) {
                const firstName = val('firstName');
                const lastName  = val('lastName');
                const email     = val('email');
                const phone     = val('phoneNumber');
                const dob       = val('dateOfBirth');
                const gender    = val('gender');
                const address   = val('address');
                const password  = field('password').value;
                const confirm   = field('confirmPassword').value;
                const terms     = field('agreeTerms');

                function fail(msg, name) {
                    window.showToast(msg, 'error');
                    if (name) highlight(name);
                    e.preventDefault();
                }

                // First Name
                if (!firstName) {
                    return fail('First name is required.', 'firstName');
                }
                if (firstName.length < 2) {
                    return fail('First name must be at least 2 characters.', 'firstName');
                }

                // Last Name
                if (!lastName) {
                    return fail('Last name is required.', 'lastName');
                }
                if (lastName.length < 2) {
                    return fail('Last name must be at least 2 characters.', 'lastName');
                }

                // Email
                if (!email) {
                    return fail('Email address is required.', 'email');
                }
                if (!emailRegex.test(email)) {
                    return fail('Please enter a valid email address (e.g. you@@email.com).', 'email');
                }

                // Phone (optional but must be valid format if filled)
                if (phone && !phoneRegex.test(phone)) {
                    return fail('Phone number format is invalid. Use digits, spaces, +, -, or parentheses.', 'phoneNumber');
                }

                // Date of Birth
                if (!dob) {
                    return fail('Date of birth is required.', 'dateOfBirth');
                }
                const age = ageFromDob(dob);
                if (age === null) {
                    return fail('Please enter a valid date of birth.', 'dateOfBirth');
                }
                if (age < 13) {
                    return fail('You must be at least 13 years old to register.', 'dateOfBirth');
                }
                if (age > 120) {
                    return fail('Please enter a realistic date of birth.', 'dateOfBirth');
                }

                // Gender
                if (!gender) {
                    return fail('Please select a gender option.', 'gender');
                }

                // Address
                if (!address) {
                    return fail('Address is required.', 'address');
                }
                if (address.length < 5) {
                    return fail('Please enter your full address (at least 5 characters).', 'address');
                }

                // Password
                if (!password) {
                    return fail('Password is required.', 'password');
                }
                if (password.length < 8) {
                    return fail('Password must be at least 8 characters long.', 'password');
                }
                if (!/[A-Za-z]/.test(password) || !/\d/.test(password)) {
                    return fail('Password must include both letters and numbers.', 'password');
                }

                // Confirm Password
                if (!confirm) {
                    return fail('Please confirm your password.', 'confirmPassword');
                }
                if (password !== confirm) {
                    return fail('Passwords do not match. Please re-enter.', 'confirmPassword');
                }

                // Terms
                if (terms && !terms.checked) {
                    return fail('You must agree to the Terms and Conditions to continue.', null);
                }
            });
        })();
    </script>
}

