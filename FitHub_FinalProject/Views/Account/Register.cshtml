@{
    ViewData["Title"] = "Register - FitHub";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<main id="register-page">

    <section id="register-hero">
        <h1>Create Your Account</h1>
        <p>Join FitHub today and start your fitness journey.</p>
    </section>

    <section id="register-form-section">
        <div id="register-container">

            <h2>Sign Up</h2>

            <form asp-controller="Account" asp-action="Register" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"></div>

                <div>
                    <label>First Name</label>
                    <input type="text" name="firstName" placeholder="e.g. Juan" required />
                    <span></span>
                </div>

                <div>
                    <label>Last Name</label>
                    <input type="text" name="lastName" placeholder="e.g. dela Cruz" required />
                    <span></span>
                </div>

                <div class="full-width">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@email.com" required />
                    <span></span>
                </div>

                <div>
                    <label>Phone Number</label>
                    <input type="tel" name="phoneNumber" placeholder="+63 912 345 6789" />
                    <span></span>
                </div>

                <div>
                    <label>Date of Birth</label>
                    <input type="date" name="dateOfBirth" />
                    <span></span>
                </div>

                <div>
                    <label>Gender</label>
                    <select name="gender">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                        <option value="PreferNotToSay">Prefer not to say</option>
                    </select>
                    <span></span>
                </div>

                <div class="full-width">
                    <label>Address</label>
                    <input type="text" name="address" placeholder="Street, City, Province" />
                    <span></span>
                </div>

                <div>
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Min. 8 characters" required />
                    <span></span>
                </div>

                <div>
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" placeholder="Re-enter your password" required />
                    <span></span>
                </div>

                <div>
                    <input type="checkbox" id="agreeTerms" name="agreeTerms" required />
                    <label for="agreeTerms">
                        I agree to the <a asp-controller="Home" asp-action="Terms">Terms and Conditions</a>
                        and <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.
                    </label>
                </div>

                <div>
                    <button type="submit">Create Account</button>
                </div>

            </form>

            <div>
                <p>Already have an account? <a asp-controller="Account" asp-action="Login">Log In here</a></p>
            </div>

        </div>
    </section>

</main>

@section Scripts {
    <script>
        (function () {
            const form = document.querySelector('#register-container form');
            if (!form) return;

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            const phoneRegex = /^[\d\s+\-()]{7,20}$/;

            function val(name) {
                const el = form.querySelector('[name="' + name + '"]');
                return el ? el.value.trim() : '';
            }

            function ageFromDob(dobStr) {
                if (!dobStr) return null;
                const dob = new Date(dobStr);
                if (isNaN(dob.getTime())) return null;
                const now = new Date();
                let age = now.getFullYear() - dob.getFullYear();
                const m = now.getMonth() - dob.getMonth();
                if (m < 0 || (m === 0 && now.getDate() < dob.getDate())) age--;
                return age;
            }

            form.addEventListener('submit', function (e) {
                let valid = true;

                const firstName = val('firstName');
                const lastName = val('lastName');
                const email = val('email');
                const phone = val('phoneNumber');
                const dob = val('dateOfBirth');
                const gender = val('gender');
                const address = val('address');
                const password = form.querySelector('[name="password"]').value;
                const confirm = form.querySelector('[name="confirmPassword"]').value;
                const agreeTerms = form.querySelector('[name="agreeTerms"]');

                if (!firstName || firstName.length < 2) {
                    window.showToast('First name must be at least 2 characters.', 'error');
                    valid = false;
                }
                if (!lastName || lastName.length < 2) {
                    window.showToast('Last name must be at least 2 characters.', 'error');
                    valid = false;
                }
                if (!email) {
                    window.showToast('Email is required.', 'error');
                    valid = false;
                } else if (!emailRegex.test(email)) {
                    window.showToast('Please enter a valid email address.', 'error');
                    valid = false;
                }
                if (phone && !phoneRegex.test(phone)) {
                    window.showToast('Phone number format is invalid.', 'error');
                    valid = false;
                }
                if (!dob) {
                    window.showToast('Date of birth is required.', 'error');
                    valid = false;
                } else {
                    const age = ageFromDob(dob);
                    if (age === null || age < 13) {
                        window.showToast('You must be at least 13 years old to register.', 'error');
                        valid = false;
                    }
                }
                if (!gender) {
                    window.showToast('Please select a gender option.', 'error');
                    valid = false;
                }
                if (!address) {
                    window.showToast('Address is required.', 'error');
                    valid = false;
                }
                if (!password || password.length < 8) {
                    window.showToast('Password must be at least 8 characters.', 'error');
                    valid = false;
                } else if (!/[A-Za-z]/.test(password) || !/\d/.test(password)) {
                    window.showToast('Password must include both letters and numbers.', 'error');
                    valid = false;
                }
                if (password !== confirm) {
                    window.showToast('Passwords do not match.', 'error');
                    valid = false;
                }
                if (agreeTerms && !agreeTerms.checked) {
                    window.showToast('You must agree to the Terms and Conditions.', 'error');
                    valid = false;
                }

                if (!valid) e.preventDefault();
            });
        })();
    </script>
}

