@{
    ViewData["Title"] = "Manage Plans - FitHub Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-plans.css" asp-append-version="true" />
}

<main id="admin-plans">

    <section id="admin-plans-header">
        <div>
            <h1>Membership Plans</h1>
            <p>View, create, edit, and manage all FitHub membership plans.</p>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="AddPlan">+ Add New Plan</a>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-message">
            <p>@TempData["SuccessMessage"]</p>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div id="error-message">
            <p>@TempData["ErrorMessage"]</p>
        </div>
    }

    <section id="admin-plans-stats">

        <div>
            <h3>Total Plans</h3>
            <p>@ViewBag.TotalPlans</p>
            <span>Available plans</span>
        </div>

        <div>
            <h3>Total Subscribers</h3>
            <p>@ViewBag.TotalSubscribers</p>
            <span>Across all plans</span>
        </div>

        <div>
            <h3>Most Popular Plan</h3>
            <p>@ViewBag.MostPopularPlan</p>
            <span>By member count</span>
        </div>

        <div>
            <h3>Total Plan Revenue</h3>
            <p>@ViewBag.TotalPlanRevenue</p>
            <span>All time</span>
        </div>

    </section>

    <section id="admin-plans-list">

        @if (Model != null && Model.Count > 0)
        {
            <table id="admin-plans-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Plan Name</th>
                        <th>Monthly Price</th>
                        <th>Annual Price</th>
                        <th>Members</th>
                        <th>Revenue</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model)
                    {
                        <tr>
                            <td>@plan.Id</td>
                            <td>@plan.PlanName</td>
                            <td>@plan.MonthlyPrice.ToString("C")</td>
                            <td>@plan.AnnualPrice.ToString("C")</td>
                            <td>@plan.MemberCount</td>
                            <td>@plan.TotalRevenue.ToString("C")</td>
                            <td>
                                <span>@plan.Status</span>
                            </td>
                            <td>
                                <a asp-controller="Admin" asp-action="EditPlan" asp-route-id="@plan.Id">Edit</a>
                                <form asp-controller="Admin" asp-action="TogglePlanStatus" asp-route-id="@plan.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">
                                        @(plan.Status == "Active" ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                                <form asp-controller="Admin" asp-action="DeletePlan" asp-route-id="@plan.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Delete this plan? Members on this plan will not be affected.')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div id="admin-plans-empty">
                <p>No membership plans found.</p>
                <a asp-controller="Admin" asp-action="AddPlan">Create First Plan</a>
            </div>
        }

    </section>

    <section id="admin-plans-form">

        <h2>@(ViewBag.EditingPlan != null ? "Edit Plan" : "Add New Plan")</h2>
        <p>@(ViewBag.EditingPlan != null ? "Update the details of the selected plan." : "Fill in the details to create a new membership plan.")</p>

        <form asp-controller="Admin" asp-action="@(ViewBag.EditingPlan != null ? "UpdatePlan" : "AddPlan")" method="post">

            @Html.AntiForgeryToken()

            @if (ViewBag.EditingPlan != null)
            {
                <input type="hidden" name="planId" value="@ViewBag.EditingPlan.Id" />
            }

            <div>
                <label for="planName">Plan Name</label>
                <input type="text" id="planName" name="planName" value="@ViewBag.EditingPlan?.PlanName" placeholder="e.g. Basic, Pro, Elite" />
            </div>

            <div>
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="3" placeholder="Brief description of this plan...">@ViewBag.EditingPlan?.Description</textarea>
            </div>

            <div>
                <label for="monthlyPrice">Monthly Price (₱)</label>
                <input type="number" id="monthlyPrice" name="monthlyPrice" value="@ViewBag.EditingPlan?.MonthlyPrice" placeholder="0.00" step="0.01" min="0" />
            </div>

            <div>
                <label for="annualPrice">Annual Price (₱)</label>
                <input type="number" id="annualPrice" name="annualPrice" value="@ViewBag.EditingPlan?.AnnualPrice" placeholder="0.00" step="0.01" min="0" />
            </div>

            <div>
                <label for="features">Features</label>
                <textarea id="features" name="features" rows="5" placeholder="List features, one per line...">@ViewBag.EditingPlan?.Features</textarea>
                <small>Enter each feature on a new line.</small>
            </div>

            <div>
                <label for="maxMembers">Max Members (leave blank for unlimited)</label>
                <input type="number" id="maxMembers" name="maxMembers" value="@ViewBag.EditingPlan?.MaxMembers" placeholder="Unlimited" min="0" />
            </div>

            <div>
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="Active" selected="@(ViewBag.EditingPlan == null || ViewBag.EditingPlan.Status == "Active")">
                        Active
                    </option>

                    <option value="Inactive" selected="@(ViewBag.EditingPlan != null && ViewBag.EditingPlan.Status == "Inactive")">
                        Inactive
                    </option>
                </select>
            </div>

            <div>
                <button type="submit">@(ViewBag.EditingPlan != null ? "Update Plan" : "Create Plan")</button>
                @if (ViewBag.EditingPlan != null)
                {
                    <a asp-controller="Admin" asp-action="Plans">Cancel</a>
                }
            </div>

        </form>

    </section>

    <section id="admin-plans-breakdown">
        <h2>Plan Feature Comparison</h2>
        <p>Overview of what each plan includes for members.</p>

        <table>
            <thead>
                <tr>
                    <th>Feature</th>
                    @if (Model != null)
                    {
                        @foreach (var plan in Model)
                        {
                            <th>@plan.PlanName</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.FeatureComparison != null)
                {
                    foreach (var feature in ViewBag.FeatureComparison)
                    {
                        <tr>
                            <td>@feature.FeatureName</td>
                            @foreach (var value in feature.Values)
                            {
                                <td>@value</td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10">No feature data available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</main>