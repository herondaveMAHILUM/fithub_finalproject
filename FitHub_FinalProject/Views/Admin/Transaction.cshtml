@{
    ViewData["Title"] = "Manage Transactions - FitHub Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-transaction.css" asp-append-version="true" />
}

<main id="admin-transactions">

    <section id="admin-transactions-header">
        <div>
            <h1>Transactions</h1>
            <p>View and manage all FitHub payment and billing records.</p>
        </div>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-message">
            <p>@TempData["SuccessMessage"]</p>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div id="error-message">
            <p>@TempData["ErrorMessage"]</p>
        </div>
    }

    <section id="admin-transactions-stats">

        <div>
            <h3>Total Transactions</h3>
            <p>@ViewBag.TotalTransactions</p>
            <span>All time</span>
        </div>

        <div>
            <h3>Total Revenue</h3>
            <p>@ViewBag.TotalRevenue</p>
            <span>All time</span>
        </div>

        <div>
            <h3>This Month</h3>
            <p>@ViewBag.MonthlyRevenue</p>
            <span>@DateTime.Now.ToString("MMMM yyyy")</span>
        </div>

        <div>
            <h3>Pending</h3>
            <p>@ViewBag.PendingCount</p>
            <span>Awaiting payment</span>
        </div>

        <div>
            <h3>Failed</h3>
            <p>@ViewBag.FailedCount</p>
            <span>Requires attention</span>
        </div>

        <div>
            <h3>Refunded</h3>
            <p>@ViewBag.RefundedCount</p>
            <span>Total refunds issued</span>
        </div>

    </section>

    <section id="admin-transactions-filters">
        <form asp-controller="Admin" asp-action="Transactions" method="get">

            <div>
                <label for="search">Search</label>
                <input type="text" id="search" name="search" value="@ViewBag.Search" placeholder="Search by member name or transaction ID..." />
            </div>

            <div>
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="">All Statuses</option>
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                    <option value="Refunded">Refunded</option>
                </select>
            </div>

            <div>
                <label for="type">Type</label>
                <select id="type" name="type">
                    <option value="">All Types</option>
                    <option value="Subscription">Subscription</option>
                    <option value="Renewal">Renewal</option>
                    <option value="Upgrade">Upgrade</option>
                    <option value="Refund">Refund</option>
                </select>
            </div>

            <div>
                <label for="plan">Plan</label>
                <select id="plan" name="plan">
                    <option value="">All Plans</option>
                    <option value="Basic">Basic</option>
                    <option value="Pro">Pro</option>
                    <option value="Elite">Elite</option>
                </select>
            </div>

            <div>
                <label for="method">Payment Method</label>
                <select id="method" name="method">
                    <option value="">All Methods</option>
                    <option value="GCash" @(ViewBag.MethodFilter == "GCash" ? "selected" : "")>GCash</option>
                    <option value="Maya" @(ViewBag.MethodFilter == "Maya" ? "selected" : "")>Maya</option>
                    <option value="CreditCard" @(ViewBag.MethodFilter == "CreditCard" ? "selected" : "")>Credit Card</option>
                    <option value="BankTransfer" @(ViewBag.MethodFilter == "BankTransfer" ? "selected" : "")>Bank Transfer</option>
                </select>
            </div>

            <div>
                <label for="dateFrom">Date From</label>
                <input type="date" id="dateFrom" name="dateFrom" value="@ViewBag.DateFrom" />
            </div>

            <div>
                <label for="dateTo">Date To</label>
                <input type="date" id="dateTo" name="dateTo" value="@ViewBag.DateTo" />
            </div>

            <div>
                <button type="submit">Filter</button>
                <a asp-controller="Admin" asp-action="Transactions">Reset</a>
            </div>

        </form>
    </section>

    <section id="admin-transactions-table">

        @if (Model != null && Model.Count > 0)
        {
            <div id="admin-transactions-summary">
                <p>Showing <strong>@Model.Count</strong> of <strong>@ViewBag.TotalTransactions</strong> transactions</p>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>Member</th>
                        <th>Plan</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model)
                    {
                        <tr>
                            <td>@transaction.TransactionId</td>
                            <td>
                                <a asp-controller="Admin" asp-action="MemberDetails" asp-route-id="@transaction.MemberId">
                                    @transaction.MemberName
                                </a>
                            </td>
                            <td>@transaction.Plan</td>
                            <td>@transaction.Type</td>
                            <td>@transaction.Amount.ToString("C")</td>
                            <td>@transaction.PaymentMethod</td>
                            <td>@transaction.Date.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span>@transaction.Status</span>
                            </td>
                            <td>
                                <a asp-controller="Admin" asp-action="TransactionDetails" asp-route-id="@transaction.TransactionId">View</a>
                                @if (transaction.Status == "Pending" || transaction.Status == "Failed")
                                {
                                    <form asp-controller="Admin" asp-action="MarkAsPaid" asp-route-id="@transaction.TransactionId" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" onclick="return confirm('Mark this transaction as Paid?')">Mark Paid</button>
                                    </form>
                                }
                                @if (transaction.Status == "Paid")
                                {
                                    <form asp-controller="Admin" asp-action="RefundTransaction" asp-route-id="@transaction.TransactionId" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" onclick="return confirm('Issue a refund for this transaction?')">Refund</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="admin-transactions-pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Admin" asp-action="Transactions"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.StatusFilter"
                           asp-route-type="@ViewBag.TypeFilter"
                           asp-route-plan="@ViewBag.PlanFilter">
                        Previous
                    </a>
                }

                <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-controller="Admin" asp-action="Transactions"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-status="@ViewBag.StatusFilter"
                           asp-route-type="@ViewBag.TypeFilter"
                           asp-route-plan="@ViewBag.PlanFilter">
                        Next
                    </a>
                }
            </div>
        }
        else
        {
            <div id="admin-transactions-empty">
                <p>No transactions found.</p>
            </div>
        }

    </section>

    <section id="admin-transactions-export">
        <h3>Export Transactions</h3>
        <p>Download the full transaction history for reporting.</p>
        <div>
            <a asp-controller="Admin" asp-action="ExportTransactions" asp-route-format="pdf">Download as PDF</a>
            <a asp-controller="Admin" asp-action="ExportTransactions" asp-route-format="csv">Download as CSV</a>
        </div>
    </section>
</main>
