@{
    ViewData["Title"] = "Manage Members - FitHub Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-members.css" asp-append-version="true" />
}

<main id="admin-members">

    <section id="admin-members-header">
        <div>
            <h1>Members</h1>
            <p>View and manage all registered FitHub members.</p>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="AddMember">+ Add New Member</a>
        </div>
    </section>

    <section id="admin-members-filters">
        <form asp-controller="Admin" asp-action="Members" method="get">

            <div>
                <label for="search">Search</label>
                <input type="text" id="search" name="search" value="@ViewBag.Search" placeholder="Search by name or email..." />
            </div>

            <div>
                <label for="plan">Plan</label>
                <select id="plan" name="plan">
                    <option value="">All Plans</option>
                    <option value="Basic" selected="@(ViewBag.PlanFilter == "Basic")">Basic</option>
                    <option value="Pro" selected="@(ViewBag.PlanFilter == "Pro")">Pro</option>
                    <option value="Elite" selected="@(ViewBag.PlanFilter == "Elite")">Elite</option>
                </select>
            </div>

            <div>
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                    <option value="Expired" selected="@(ViewBag.StatusFilter == "Expired")">Expired</option>
                    <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
                    <option value="Frozen" selected="@(ViewBag.StatusFilter == "Frozen")">Frozen</option>
                </select>
            </div>

            <div>
                <label for="gender">Gender</label>
                <select id="gender" name="gender">
                    <option value="">All</option>
                    <option value="Male" selected="@(ViewBag.GenderFilter == "Male")">Male</option>
                    <option value="Female" selected="@(ViewBag.GenderFilter == "Female")">Female</option>
                    <option value="Other" selected="@(ViewBag.GenderFilter == "Other")">Other</option>
                </select>
            </div>

            <div>
                <label for="dateFrom">Joined From</label>
                <input type="date" id="dateFrom" name="dateFrom" value="@ViewBag.DateFrom" />
            </div>

            <div>
                <label for="dateTo">Joined To</label>
                <input type="date" id="dateTo" name="dateTo" value="@ViewBag.DateTo" />
            </div>

            <div>
                <button type="submit">Filter</button>
                <a asp-controller="Admin" asp-action="Members">Reset</a>
            </div>

        </form>
    </section>

    <section id="admin-members-table">

        @if (Model != null && Model.Count > 0)
        {
            <div id="admin-members-summary">
                <p>Showing <strong>@Model.Count</strong> of <strong>@ViewBag.TotalMembers</strong> members</p>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Date Joined</th>
                        <th>Expiry Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td>@member.Id</td>
                            <td>@member.FullName</td>
                            <td>@member.Email</td>
                            <td>@member.PhoneNumber</td>
                            <td>@member.MembershipPlan</td>
                            <td>
                                <span>@member.Status</span>
                            </td>
                            <td>@member.DateJoined.ToString("MMM dd, yyyy")</td>
                            <td>@member.ExpiryDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a asp-controller="Admin" asp-action="MemberDetails" asp-route-id="@member.Id">View</a>
                                <a asp-controller="Admin" asp-action="EditMember" asp-route-id="@member.Id">Edit</a>
                                <form asp-controller="Admin" asp-action="DeleteMember" asp-route-id="@member.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" onclick="return confirm('Are you sure you want to delete this member?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="admin-members-pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Admin" asp-action="Members"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-plan="@ViewBag.PlanFilter"
                           asp-route-status="@ViewBag.StatusFilter">
                        Previous
                    </a>
                }

                <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-controller="Admin" asp-action="Members"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-plan="@ViewBag.PlanFilter"
                           asp-route-status="@ViewBag.StatusFilter">
                        Next
                    </a>
                }
            </div>
        }
        else
        {
            <div id="admin-members-empty">
                <p>No members found.</p>
                <a asp-controller="Admin" asp-action="AddMember">Add First Member</a>
            </div>
        }

    </section>

    <section id="admin-members-export">
        <h3>Export Members</h3>
        <p>Download the full member list for your records.</p>
        <div>
            <a asp-controller="Admin" asp-action="ExportMembers" asp-route-format="pdf">Download as PDF</a>
            <a asp-controller="Admin" asp-action="ExportMembers" asp-route-format="csv">Download as CSV</a>
        </div>
    </section>
</main>