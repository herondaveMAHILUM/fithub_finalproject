<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FitHub - Your Fitness Journey Starts Here" />
    <title>@ViewData["Title"] - FitHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav>
        <div>
            <a asp-controller="Home" asp-action="Index">
                <span>Fit</span><span>Hub</span>
            </a>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            if (User.IsInRole("Admin"))
            {
                <ul>
                    <li><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                    <li><a asp-controller="Admin" asp-action="Members">Members</a></li>
                    <li><a asp-controller="Admin" asp-action="Plans">Plans</a></li>
                    <li><a asp-controller="Admin" asp-action="Transactions">Transactions</a></li>
                    <li><a asp-controller="Admin" asp-action="Profile">Profile</a></li>
                    <li class="notif-logout-sep">
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit">Log Out</button>
                        </form>
                    </li>
                </ul>
            }
            else
            {
                <ul>
                    <li><a asp-controller="User" asp-action="Dashboard">Dashboard</a></li>
                    <li><a asp-controller="Membership" asp-action="Index">Membership</a></li>
                    <li><a asp-controller="Transactions" asp-action="Index">Transactions</a></li>
                    <li><a asp-controller="Account" asp-action="Profile">Profile</a></li>
                    @await Component.InvokeAsync("NotificationBell")
                    <li class="notif-logout-sep">
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit">Log Out</button>
                        </form>
                    </li>
                </ul>
            }
        }
        else
        {
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a href="/#membership-preview">Membership</a></li>
                <li><a asp-controller="Account" asp-action="Login">Log In</a></li>
                <li><a asp-controller="Account" asp-action="Register">Register</a></li>
            </ul>
        }

    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div>
            <div>
                <h4>FitHub</h4>
                <p>Your fitness journey starts here. Train smart, live strong.</p>
            </div>
            <div>
                <h4>Quick Links</h4>
                <ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <li><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li><a asp-controller="Admin" asp-action="Members">Members</a></li>
                            <li><a asp-controller="Admin" asp-action="Plans">Plans</a></li>
                            <li><a asp-controller="Admin" asp-action="Transactions">Transactions</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="User" asp-action="Dashboard">Dashboard</a></li>
                            <li><a asp-controller="Membership" asp-action="Index">Membership</a></li>
                            <li><a asp-controller="Transactions" asp-action="Index">Transactions</a></li>
                            <li><a asp-controller="Account" asp-action="Profile">Profile</a></li>
                        }
                    }
                    else
                    {
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a href="/#membership-preview">Membership</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Log In</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
            <div>
                <h4>Contact</h4>
                <p>123 Fitness Street, Cebu City</p>
                <p>info@fithub.ph</p>
                <p>+63 912 345 6789</p>
            </div>
        </div>
        <div>
            <p>&copy; @DateTime.Now.Year FitHub. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { window.showToast(@Html.Raw(Json.Serialize(TempData["SuccessMessage"])), 'success'); });</script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { window.showToast(@Html.Raw(Json.Serialize(TempData["ErrorMessage"])), 'error'); });</script>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { window.showToast(@Html.Raw(Json.Serialize(TempData["InfoMessage"])), 'info'); });</script>
    }

    <script>
        (function () {
            var btn = document.getElementById('notif-bell-btn');
            var dropdown = document.getElementById('notif-dropdown');
            if (!btn || !dropdown) return;
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
            });
            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove('open');
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
