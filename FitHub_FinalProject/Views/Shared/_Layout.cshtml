<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FitHub - Your Fitness Journey Starts Here" />
    <title>@ViewData["Title"] - FitHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav>
        <div>
            <a asp-controller="Home" asp-action="Index">
                <span>Fit</span><span>Hub</span>
            </a>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <ul>
                <li><a asp-controller="User" asp-action="Dashboard">Dashboard</a></li>
                <li><a asp-controller="Membership" asp-action="Index">Membership</a></li>
                <li><a asp-controller="Transaction" asp-action="Index">Transactions</a></li>
                <li><a asp-controller="Account" asp-action="Profile">Profile</a></li>

                <li class="notif-nav-item" id="notif-nav-item">
                    <button class="notif-bell-btn" id="notif-bell-btn" type="button" aria-label="Notifications">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        @if (ViewBag.NavNotificationCount != null && ViewBag.NavNotificationCount > 0)
                        {
                            <span class="notif-badge">@ViewBag.NavNotificationCount</span>
                        }
                    </button>

                    <div class="notif-dropdown" id="notif-dropdown">
                        <div class="notif-dropdown-header">
                            <span>Notifications</span>
                            @if (ViewBag.NavNotificationCount != null && ViewBag.NavNotificationCount > 0)
                            {
                                <span class="notif-dropdown-count">@ViewBag.NavNotificationCount unread</span>
                            }
                        </div>
                        <ul class="notif-dropdown-list">
                            @if (ViewBag.NavNotifications != null)
                            {
                                foreach (var notif in ViewBag.NavNotifications)
                                {
                                    <li class="notif-dropdown-item notif-@notif.Type.ToLower()">
                                        <p class="notif-dropdown-title">@notif.Title</p>
                                        <p class="notif-dropdown-desc">@notif.Description</p>
                                        <span class="notif-dropdown-time">@notif.TimeAgo</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="notif-dropdown-empty">No new notifications.</li>
                            }
                        </ul>
                    </div>
                </li>

                <li class="notif-logout-sep">
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit">Log Out</button>
                    </form>
                </li>
            </ul>
        }
        else
        {
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a href="/#membership-preview">Membership</a></li>
                <li><a asp-controller="Account" asp-action="Login">Log In</a></li>
                <li><a asp-controller="Account" asp-action="Register">Register</a></li>
            </ul>
        }

    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div>
            <div>
                <h4>FitHub</h4>
                <p>Your fitness journey starts here. Train smart, live strong.</p>
            </div>
            <div>
                <h4>Quick Links</h4>
                <ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li><a asp-controller="User" asp-action="Dashboard">Dashboard</a></li>
                        <li><a asp-controller="Membership" asp-action="Index">Membership</a></li>
                        <li><a asp-controller="Transaction" asp-action="Index">Transactions</a></li>
                        <li><a asp-controller="Account" asp-action="Profile">Profile</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a href="/#membership-preview">Membership</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Log In</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
            <div>
                <h4>Contact</h4>
                <p>123 Fitness Street, Cebu City</p>
                <p>info@fithub.ph</p>
                <p>+63 912 345 6789</p>
            </div>
        </div>
        <div>
            <p>&copy; @DateTime.Now.Year FitHub. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var btn = document.getElementById('notif-bell-btn');
            var dropdown = document.getElementById('notif-dropdown');
            if (!btn || !dropdown) return;
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('open');
            });
            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target)) {
                    dropdown.classList.remove('open');
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>