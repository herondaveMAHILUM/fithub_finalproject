<li class="notif-nav-item" id="notif-nav-item">
    <button class="notif-bell-btn" id="notif-bell-btn" type="button" aria-label="Notifications">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        @if (ViewBag.UnreadCount != null && (int)ViewBag.UnreadCount > 0)
        {
            <span class="notif-badge">@ViewBag.UnreadCount</span>
        }
    </button>

    <div class="notif-dropdown" id="notif-dropdown">
        <div class="notif-dropdown-header">
            <span>Notifications</span>
            @if (ViewBag.UnreadCount != null && (int)ViewBag.UnreadCount > 0)
            {
                <span class="notif-dropdown-count">@ViewBag.UnreadCount unread</span>
            }
        </div>
        <ul class="notif-dropdown-list">
            @if (ViewBag.Notifications != null)
            {
                foreach (var notif in ViewBag.Notifications)
                {
                    <li class="notif-dropdown-item notif-@notif.Type.ToLower()">
                        <p class="notif-dropdown-title">@notif.Title</p>
                        <p class="notif-dropdown-desc">@notif.Description</p>
                        <span class="notif-dropdown-time">@notif.TimeAgo</span>
                    </li>
                }
            }
            else
            {
                <li class="notif-dropdown-empty">No new notifications.</li>
            }
        </ul>
    </div>
</li>
